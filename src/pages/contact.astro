---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SERVICE_AREAS, HOURS } from '../site.config';
---
<BaseLayout
  title="Contact Us for Small Job Handyman Services | Same Day Service"
  description="Contact us for small handyman jobs and quick repairs. Same-day service available. Call, text, or email for free estimates on all small home improvement projects."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Contact Us for Small Jobs</h1>
      <p>
        Ready to cross items off your honey-do list? We're here to help with same-day service for
        most small jobs. Every project begins with a conversation — and a detailed, no-obligation
        estimate.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="reach-heading">
    <div class="wrap">
      <h2 id="reach-heading">The Fastest Ways to Reach Us</h2>
      <div class="contact-grid">
        <div class="contact-card">
          <h3>📞 Call or Text</h3>
          <a class="big" href={SITE.phoneHref}>{SITE.phoneDisplay}</a>
          <p>
            Best for urgent repairs and immediate scheduling. Monday–Friday 7 AM–6 PM, Saturday
            8 AM–4 PM. Emergency services available 24/7.
          </p>
        </div>
        <div class="contact-card">
          <h3>📧 Email</h3>
          <a class="big" href={SITE.emailHref}>{SITE.email}</a>
          <p>
            Ideal for project details and photos — send a quick description plus pictures for a
            faster estimate. We respond within 24 hours.
          </p>
        </div>
        <div class="contact-card">
          <h3>🚨 Emergencies</h3>
          <a class="big" href={SITE.phoneHref}>{SITE.phoneDisplay}</a>
          <p>
            24/7 for water leaks causing damage, electrical hazards, security issues, and HVAC
            failures in extreme weather. After-hours rates are always discussed before work begins.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="expect-heading">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">No Surprises</span>
        <h2 id="expect-heading">What to Expect</h2>
      </div>
      <div class="grid grid--cards">
        <article class="card">
          <h3>1. Initial Contact</h3>
          <p>Friendly, professional response, a basic project discussion, and scheduling of your on-site estimate.</p>
        </article>
        <article class="card">
          <h3>2. On-Site Estimate</h3>
          <p>Detailed project assessment with a written estimate and breakdown. Timeline discussed. No pressure, no obligation.</p>
        </article>
        <article class="card">
          <h3>3. Quality Execution</h3>
          <p>Professional workmanship with regular communication and a clean, organized work site. Your satisfaction guaranteed.</p>
        </article>
      </div>
      <p style="margin-top:1.25rem;max-width:46rem">
        All estimates are provided in writing. We accept cash, check, credit cards, and financing
        options for larger projects. Fully licensed, bonded, and insured — documentation available
        upon request.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="hours-heading">
    <div class="wrap">
      <h2 id="hours-heading">Office Hours</h2>
      <div class="grid grid--cards">
        {HOURS.map((row) => (
          <article class="card">
            <h3>{row.days}</h3>
            <p style="font-weight:700;color:var(--navy-800);margin-bottom:0.25rem">{row.hours}</p>
            <p style="margin:0">{row.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="area-heading">
    <div class="wrap">
      <h2 id="area-heading">Who We Serve</h2>
      <p style="max-width:46rem">
        Same-day estimates in our primary area — {SERVICE_AREAS.primary.map((a) => a.town.replace(', NY', '')).join(', ')} —
        with no travel fees. Next-day estimates throughout Chemung County and the Finger Lakes
        region, including {SERVICE_AREAS.extended.slice(0, 5).join(', ')}, and more. Not sure if we
        service your area? Call us — we're always expanding.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-label="Call to action">
    <div class="wrap" style="text-align:center">
      <h2>Ready to Get Started?</h2>
      <p style="max-width:42rem;margin-inline:auto">
        Quick questions → call. Project planning → email. Your home improvement project starts with
        a simple conversation.
      </p>
      <p style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap">
        <a class="btn btn--primary" href={SITE.phoneHref}>📞 {SITE.phoneDisplay}</a>
        <a class="btn btn--outline" href={SITE.emailHref}>📧 {SITE.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>
