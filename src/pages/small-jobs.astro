---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const entry = await getEntry('pages', 'small-jobs');
if (!entry) throw new Error('Missing content: pages/small-jobs');
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <section class="page-hero">
    <div class="wrap">
      <h1>Small Handyman Jobs — Our Specialty</h1>
      <p>
        No job too small! We specialize in the quick fixes and small improvements that other
        contractors won't touch.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
