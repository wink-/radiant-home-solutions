---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
---
<BaseLayout
  title="Page Not Found (404)"
  description="The page you were looking for could not be found."
>
  <section class="not-found">
    <div class="wrap">
      <h1>404</h1>
      <p style="font-size:1.2rem">That page seems to have wandered off to another job site.</p>
      <p>Try one of these instead:</p>
      <p style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap">
        <a class="btn btn--primary" href="/">Home</a>
        <a class="btn btn--outline" href="/services/">Services</a>
        <a class="btn btn--outline" href="/contact/">Contact</a>
      </p>
      <p style="margin-top:1.5rem">
        Or call for same-day service:
        <a href={SITE.phoneHref}><strong>{SITE.phoneDisplay}</strong></a>
      </p>
    </div>
  </section>
</BaseLayout>
